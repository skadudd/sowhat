{
  "name": "sowhat-cc",
  "version": "2.3.1",
  "description": "Structured argumentation system for Claude Code. Build logic-driven PRDs with Toulmin, Walton, and Minto Pyramid frameworks.",
  "bin": {
    "sowhat-cc": "bin/install.js"
  },
  "files": [
    "bin",
    "commands",
    "agents",
    "sowhat-core"
  ],
  "os": ["darwin", "linux", "win32"],
  "keywords": [
    "claude",
    "claude-code",
    "argumentation",
    "toulmin",
    "prd",
    "planning",
    "spec-driven",
    "ai"
  ],
  "author": "ynamroot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ynamroot/sowhat.git"
  },
  "homepage": "https://github.com/ynamroot/sowhat",
  "bugs": {
    "url": "https://github.com/ynamroot/sowhat/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ynamroot"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "claude-code": ">=2.1.3"
  },
  "peerDependenciesMeta": {
    "claude-code": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node scripts/test-source-tags.js && node scripts/test-draft-hallucination-guard.js",
    "lint": "node scripts/build.js --dry-run",
    "audit:skills": "npx skillgrade .claude/commands/sowhat",
    "prepublishOnly": "npm run test && npm run build && npm run audit:skills"
  }
}
